# Optionale Umgebungsvariablen fuer den Compose-Stack.
# Kopieren nach .env, wenn Anpassungen noetig sind:  cp .env.example .env

# UID, unter der die Airflow-Container laufen. Nur unter LINUX relevant, damit
# die gemounteten Ordner (airflow/logs, airflow/config) beschreibbar sind:
#   echo "AIRFLOW_UID=$(id -u)" >> .env
# Unter macOS / Windows (Docker Desktop) kann der Standardwert bleiben.
AIRFLOW_UID=50000
